# Copy this file to .env for local development.
DEBUG=True
# If blank, Django generates a random process-local key for development.
# Set a persistent secret in production; never commit the real .env file.
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# Match the local PostgreSQL port in docker-compose.yml.
DB_NAME=startup_db
DB_USER=startup_user
DB_PASSWORD=startup_password
DB_HOST=127.0.0.1
DB_PORT=5433

# Optional for local development. Use shared Redis cache in production
# so API rate limits are consistent across application workers.
REDIS_URL=

# API rate limits (per client IP for anonymous requests).
API_ANON_RATE_LIMIT=120/min
API_USER_RATE_LIMIT=600/min

# API documentation is available automatically when DEBUG=True.
API_DOCS_ENABLED=False

# Frontend API origin (Next.js reads NEXT_PUBLIC_* variables).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
