# Copy this file to .env for local development.
DEBUG=True
# A development-only value is generated automatically when DEBUG=True.
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# Match the local PostgreSQL port in docker-compose.yml.
DB_NAME=startup_db
DB_USER=startup_user
DB_PASSWORD=startup_password
DB_HOST=127.0.0.1
DB_PORT=5433

# Optional. Leave empty to use Django's local-memory cache.
REDIS_URL=

# API documentation is available automatically when DEBUG=True.
API_DOCS_ENABLED=False
\n# Frontend API origin (Next.js reads NEXT_PUBLIC_* variables).\nNEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000\n